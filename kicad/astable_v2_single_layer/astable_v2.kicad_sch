	(text "JR1 / JR2 pick the base resistor (22k / 47k / 100k), JC1 / JC2 pick the timing cap (4.7u / 10u / 47u): one shunt per header." (exclude_from_sim no) (at 22.86 168.91 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "7f3f585d-1861-5f33-bbf4-9aa135e05f43"))
	(text "f = 1 / (1.386 * Rb * C):  22k/4.7u 7 Hz ... 47k/10u 1.5 Hz ... 100k/47u 0.15 Hz.  Supply 3 to 9 V, 5 V recommended." (exclude_from_sim no) (at 22.86 172.72 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "d792e358-a5f3-560a-b16d-66867999eb7a"))
	(text "Unselected caps float on the + side and stay tied to the base on the - side; unselected resistors float at the base end." (exclude_from_sim no) (at 22.86 176.53 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "0b46ee82-f22a-554c-bc9b-4e0fd646e39d"))
